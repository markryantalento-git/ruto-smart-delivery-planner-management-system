rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function optionalString(data, field, maxLength) {
      return !(field in data) ||
        (data[field] is string && data[field].size() <= maxLength);
    }

    function validNumber(value, minValue, maxValue) {
      return (value is int || value is float) &&
        value >= minValue && value <= maxValue;
    }

    function validPoint(point) {
      return point is map &&
        point.keys().hasOnly(['lat', 'lng', 'name']) &&
        point.keys().hasAll(['lat', 'lng', 'name']) &&
        validNumber(point.lat, -90, 90) &&
        validNumber(point.lng, -180, 180) &&
        point.name is string && point.name.size() <= 200;
    }

    function validConsent(consent) {
      return consent is map &&
        consent.keys().hasOnly(['accepted', 'policyVersion', 'acceptedAt']) &&
        consent.keys().hasAll(['accepted', 'policyVersion', 'acceptedAt']) &&
        consent.accepted == true &&
        consent.policyVersion == '1.0' &&
        consent.acceptedAt is timestamp;
    }

    function validUserProfile(data) {
      return data.keys().hasOnly([
          'name', 'displayName', 'email', 'phone', 'provider', 'createdAt',
          'consent', 'accountType', 'companyName', 'photoURL', 'appVersion'
        ]) &&
        data.keys().hasAll(['createdAt', 'consent']) &&
        data.createdAt is timestamp &&
        validConsent(data.consent) &&
        optionalString(data, 'name', 120) &&
        optionalString(data, 'displayName', 120) &&
        optionalString(data, 'email', 254) &&
        optionalString(data, 'phone', 20) &&
        optionalString(data, 'provider', 32) &&
        (!('accountType' in data) ||
          data.accountType in ['personal', 'company']) &&
        optionalString(data, 'companyName', 160) &&
        optionalString(data, 'photoURL', 2048) &&
        optionalString(data, 'appVersion', 32) &&
        (!('accountType' in data) ||
          data.accountType != 'company' ||
          ('companyName' in data && data.companyName.size() > 0));
    }

    function validDelivery(data) {
      return data.keys().hasOnly([
          'id', 'ts', 'seq', 'date', 'time', 'scheduled', 'done', 'origin',
          'stops', 'order', 'round', 'pri', 'tmode', 'veh', 'veh2',
          'cost', 'fuelCost', 'km', 'hrs'
        ]) &&
        data.keys().hasAll([
          'id', 'ts', 'seq', 'date', 'time', 'scheduled', 'done', 'origin',
          'stops', 'order', 'round', 'pri', 'tmode', 'veh', 'veh2',
          'cost', 'fuelCost', 'km', 'hrs'
        ]) &&
        data.id is int && data.ts is int && data.seq is int &&
        data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.time is string && data.time.matches('^[0-9]{2}:[0-9]{2}$') &&
        data.scheduled is bool && data.done is bool && data.round is bool &&
        validPoint(data.origin) &&
        data.stops is list && data.order is list &&
        data.stops.size() > 0 && data.order.size() == data.stops.size() &&
        data.pri in ['balanced', 'cheap', 'fast', 'easy'] &&
        data.tmode in ['auto', 'land', 'water'] &&
        data.veh in [
          'moto', 'etrike', 'trike', 'car', 'jeep', 'van', 'pickup',
          't2', 't5', 't10', 'bangka', 'cargo'
        ] &&
        (data.veh2 == null || data.veh2 in [
          'moto', 'etrike', 'trike', 'car', 'jeep', 'van', 'pickup',
          't2', 't5', 't10', 'bangka', 'cargo'
        ]) &&
        validNumber(data.cost, 0, 1000000000) &&
        validNumber(data.fuelCost, 0, 1000000000) &&
        validNumber(data.km, 0, 10000000) &&
        validNumber(data.hrs, 0, 1000000);
    }

    function validNotification(data, notificationId) {
      return data.keys().hasOnly(['id', 'key', 'title', 'body', 'at', 'read']) &&
        data.keys().hasAll(['id', 'title', 'body', 'at', 'read']) &&
        data.id is string && data.id == notificationId &&
        optionalString(data, 'key', 200) &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
        data.body is string && data.body.size() <= 600 &&
        data.at is int && data.at >= 0 &&
        data.read is bool;
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create: if owns(uid) &&
        validUserProfile(request.resource.data) &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.consent.acceptedAt == request.time;
      allow update: if owns(uid) &&
        validUserProfile(request.resource.data) &&
        (('createdAt' in resource.data)
          ? request.resource.data.createdAt == resource.data.createdAt
          : request.resource.data.createdAt == request.time) &&
        (('consent' in resource.data)
          ? request.resource.data.consent == resource.data.consent
          : request.resource.data.consent.acceptedAt == request.time);
      allow delete: if owns(uid);

      match /deliveries/{deliveryId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid) && validDelivery(request.resource.data);
        allow delete: if owns(uid);
      }

      match /notifications/{notificationId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid) &&
          validNotification(request.resource.data, notificationId);
        allow delete: if owns(uid);
      }
    }

    // Nationwide fuel prices: every signed-in user can read; edit only in the Firebase console
    match /public/fuel {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
