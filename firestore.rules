rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function optionalString(data, field, maxLength) {
      return !(field in data) ||
        (data[field] is string && data[field].size() <= maxLength);
    }

    function validNumber(value, minValue, maxValue) {
      return (value is int || value is float) &&
        value >= minValue && value <= maxValue;
    }

    function validPoint(point) {
      return point is map &&
        point.keys().hasOnly(['lat', 'lng', 'name']) &&
        point.keys().hasAll(['lat', 'lng', 'name']) &&
        validNumber(point.lat, -90, 90) &&
        validNumber(point.lng, -180, 180) &&
        point.name is string && point.name.size() <= 200;
    }

    function validDelivery(data) {
      return data.keys().hasOnly([
          'id', 'ts', 'seq', 'date', 'time', 'scheduled', 'done', 'origin',
          'stops', 'order', 'round', 'pri', 'tmode', 'veh', 'veh2',
          'cost', 'fuelCost', 'km', 'hrs'
        ]) &&
        data.keys().hasAll([
          'id', 'ts', 'seq', 'date', 'time', 'scheduled', 'done', 'origin',
          'stops', 'order', 'round', 'pri', 'tmode', 'veh', 'veh2',
          'cost', 'fuelCost', 'km', 'hrs'
        ]) &&
        data.id is int && data.ts is int && data.seq is int &&
        data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.time is string && data.time.matches('^[0-9]{2}:[0-9]{2}$') &&
        data.scheduled is bool && data.done is bool && data.round is bool &&
        validPoint(data.origin) &&
        data.stops is list && data.order is list &&
        data.stops.size() > 0 && data.order.size() == data.stops.size() &&
        data.pri in ['balanced', 'cheap', 'fast', 'easy'] &&
        data.tmode in ['auto', 'land', 'water'] &&
        data.veh in [
          'moto', 'etrike', 'trike', 'car', 'jeep', 'van', 'pickup',
          't2', 't5', 't10', 'bangka', 'cargo'
        ] &&
        (data.veh2 == null || data.veh2 in [
          'moto', 'etrike', 'trike', 'car', 'jeep', 'van', 'pickup',
          't2', 't5', 't10', 'bangka', 'cargo'
        ]) &&
        validNumber(data.cost, 0, 1000000000) &&
        validNumber(data.fuelCost, 0, 1000000000) &&
        validNumber(data.km, 0, 10000000) &&
        validNumber(data.hrs, 0, 1000000);
    }

    match /users/{uid} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) &&
        request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'provider', 'createdAt',
          'accountType', 'companyName', 'photoURL'
        ]) &&
        request.resource.data.createdAt is timestamp &&
        optionalString(request.resource.data, 'name', 120) &&
        optionalString(request.resource.data, 'email', 254) &&
        optionalString(request.resource.data, 'phone', 20) &&
        optionalString(request.resource.data, 'provider', 32) &&
        (!('accountType' in request.resource.data) ||
          request.resource.data.accountType in ['personal', 'company']) &&
        optionalString(request.resource.data, 'companyName', 160) &&
        optionalString(request.resource.data, 'photoURL', 2048) &&
        (!('accountType' in request.resource.data) ||
          request.resource.data.accountType != 'company' ||
          ('companyName' in request.resource.data &&
            request.resource.data.companyName.size() > 0));
      allow delete: if false;

      match /deliveries/{deliveryId} {
        allow read: if owns(uid);
        allow create, update: if owns(uid) && validDelivery(request.resource.data);
        allow delete: if owns(uid);
      }
    }

    // Nationwide fuel prices: every signed-in user can read; edit only in the Firebase console
    match /public/fuel {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
